{
  "name": "@stoadex/agent-tools",
  "version": "0.1.0",
  "description": "Stoa's swap tools for AI agents on Robinhood Chain: quote across every venue, check a token, build an unsigned swap, bridge in and market context. Adapters for the Vercel AI SDK, LangChain and OpenAI. No key.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://stoadex.com/docs/mcp",
  "repository": { "type": "git", "url": "git+https://github.com/StoaDex/Stoa.git", "directory": "sdk/agent-tools" },
  "keywords": ["robinhood-chain", "dex", "swap", "ai-agent", "mcp", "vercel-ai-sdk", "langchain", "openai", "defi", "stoa"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./ai": { "types": "./dist/ai.d.ts", "import": "./dist/ai.js" },
    "./langchain": { "types": "./dist/langchain.d.ts", "import": "./dist/langchain.js" },
    "./openai": { "types": "./dist/openai.d.ts", "import": "./dist/openai.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": { "build": "tsc -p tsconfig.json", "test": "node --test test/live.test.mjs", "prepublishOnly": "npm run build" },
  "peerDependencies": { "ai": ">=5", "@langchain/core": ">=0.3" },
  "peerDependenciesMeta": { "ai": { "optional": true }, "@langchain/core": { "optional": true } },
  "devDependencies": { "typescript": "^5.6.0", "ai": "^7.0.0", "@langchain/core": "^1.4.0", "@types/node": "^22.0.0" }
}
