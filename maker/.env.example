# --- chain ---
RPC_URL=https://<elysium-rpc>
# WS_URL=wss://<elysium-ws>          # optional, faster block notifications
CHAIN_ID=99901
PRIVATE_KEY=0x...                    # maker hot wallet: holds only gas HYPE, never pool funds
POOL=0x...                           # StoaPool address

# --- price source ---
PRICE_SOURCE=hyperliquid             # or "static" for dry runs
HL_COIN=HYPE
# STATIC_MID=40

# --- quoting ---
BASE_SPREAD_BPS=8
MIN_SPREAD_BPS=4
VOL_MULTIPLIER=1.5
SKEW_BPS=10
SIDE_NOTIONAL_USD=750
VALID_BLOCKS=2
INVENTORY_USE=0.9

# --- risk ---
MAX_INVENTORY_RATIO=0.8
MAX_DAILY_LOSS_USD=150
MAX_PRICE_AGE_MS=1500
JUMP_BPS=150
COOLDOWN_MS=5000
KILL_FILE=./KILL

# --- transactions ---
PRIORITY_FEE_GWEI=0.5
GAS_LIMIT=120000
MAX_PENDING_TX=3
POLL_MS=100

DRY_RUN=0
HEALTH_PORT=8787
