# Elysium
NEXT_PUBLIC_CHAIN_ID=99901
# one or more, comma-separated (first = primary, rest = fallback)
NEXT_PUBLIC_RPC_URL=https://elysium-mainnet.g.alchemy.com/v2/<key>,https://lb.drpc.live/elysium/<key>
NEXT_PUBLIC_EXPLORER_URL=https://<elysium-explorer>

# Robinhood Chain (4663): reads and transactions, comma-separated (first = primary). Default: the public RPC.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<key>,https://lb.drpc.live/robinhood/<key>,https://rpc.mainnet.chain.robinhood.com
# eth_getLogs only. Keep the public RPC: free Alchemy/dRPC plans cap the block range (10 / 10,000 blocks).
NEXT_PUBLIC_ROBINHOOD_LOGS_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Stoa contracts (leave empty until deployed: the app then shows "not deployed yet")
NEXT_PUBLIC_ROUTER=
NEXT_PUBLIC_POOL_WHYPE_USDC=
NEXT_PUBLIC_FEE_DISTRIBUTOR=

# WalletConnect (Reown) project id, optional: without it only browser wallets are offered
NEXT_PUBLIC_WC_PROJECT_ID=

# Shown in the footer once the token is live (leave empty before)
NEXT_PUBLIC_CA=

NEXT_PUBLIC_SITE_URL=https://stoadex.com
# Signs buy-from-any-chain quotes (server only; any random 32+ characters). Falls back to one derived from TRUSTWARE_API_KEY.
ANYCHAIN_HMAC_SECRET=

# Gloam partner link code (public). Added as p=<code> to Gloam swap links so swaps opened from Stoa count to Stoa.
NEXT_PUBLIC_GLOAM_LINK_CODE=
